<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | IPCA Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="auth-wrapper">
        <div class="auth-card">
            <div class="auth-logo">
                <img src="/img/logoipca.png" alt="IPCA Logo"
                    style="max-height: 80px; width: auto; filter: drop-shadow(0px 2px 4px rgba(0,0,0,0.1));">
            </div>
            <h3 class="auth-title">Bem-vindo ao IPCA</h3>

            <% if(erro) { %>
                <div class="alert alert-danger mb-4">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>
                    <%= erro %>
                </div>
                <% } %>

                    <form action="/auth/login" method="POST">
                        <div class="mb-4">
                            <label class="form-label">Email Institucional</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 text-muted"><i
                                        class="fa-regular fa-envelope"></i></span>
                                <input type="email" name="email" class="form-control border-start-0 ps-0"
                                    placeholder="exemplo@ipca.pt" required>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Palavra-passe</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 text-muted"><i
                                        class="fa-solid fa-lock"></i></span>
                                <input type="password" name="senha" class="form-control border-start-0 ps-0"
                                    placeholder="••••••••" required>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 mb-4 py-2 mt-2">Entrar no Portal <i
                                class="fa-solid fa-arrow-right ms-2"></i></button>
                        <div class="text-center mt-3">
                            <span class="text-muted">Ainda não tem conta?</span> <a href="/registar"
                                class="auth-link">Criar conta agora</a>
                        </div>
                    </form>
        </div>
    </div>
    <script src="/js/theme.js"></script>
</body>

</html>